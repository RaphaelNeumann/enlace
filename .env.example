# Supabase Postgres (Settings -> Database -> Connection string -> Transaction pooler, port 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres"

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=""
# In production, set AUTH_URL to the public site URL (e.g. https://your-domain.com)
# AUTH_URL=""

# Magic-link email provider (Resend). https://resend.com/api-keys
AUTH_RESEND_KEY=""
# Sender address. In dev with no verified domain, use "onboarding@resend.dev".
# In production, set to an address on a domain verified in Resend.
AUTH_EMAIL_FROM="onboarding@resend.dev"

# Admin allowlist. Emails outside these lists cannot sign in to /admin.
# Separate multiple emails with comma or semicolon.
AUTH_COUPLE_EMAILS=""
AUTH_CEREMONIAL_EMAILS=""

# Supabase Storage (optional — photo gallery, monogram, hero illustration,
# programação / dress-code icons, gift photos)
# NEXT_PUBLIC_SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""

# RSVP access (optional — token appended to /rsvp/<token> for the public link)
# RSVP_ACCESS_TOKEN=""

# Gifts: PIX (optional). Only PIX_KEY is required for the QR-Code to render;
# the BR-Code spec infers the key type from its format (CPF / CNPJ / email /
# phone / random UUID). PIX_RECIPIENT_NAME and PIX_CITY are surfaced in the
# bank app when a guest scans the code — set them so the merchant info isn't
# the generic fallback ("RECIPIENT" / "BRASIL").
# PIX_KEY=""
# PIX_RECIPIENT_NAME=""
# PIX_CITY=""

# Gifts: Mercado Pago Checkout Pro (optional — enables the "Pagar com cartão"
# button next to the PIX block). The button only appears when this token is
# set AND the gift has a suggested amount.
# MERCADO_PAGO_ACCESS_TOKEN=""
